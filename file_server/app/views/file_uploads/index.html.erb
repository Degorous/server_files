<div class="file_upload_index">
  <div class="files">
    <% @archives.each do |file| %>
        <div class="archive_card">
          <%= link_to file.name, file_upload_path(file), class: 'link' %>
          <%= render_file(file.file, class: 'image')%>

          <div class="archive_buttons">
            <%= link_to 'Baixar', rails_blob_url(file.file), download: file.name, class: 'button' %>
            <%= link_to 'Editar', edit_file_upload_path(file), class: 'button' %>
            <%= link_to 'Deletar', file_upload_path(file), data: {turbo_method: :delete, turbo_confirm: 'Tem certeza que deseja deletar?'}, class: 'button' %>
          </div>
        </div>
    <% end %>
  </div>
</div>