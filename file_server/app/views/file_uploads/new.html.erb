<div class="container">
  <div class="file_upload_new" >
    <h1> Upload de Arquivo </h1>

    <%= form_with model: @archive, url: file_uploads_path, local: true, multipart: true do |form| %>
      <div class="card">
        <div class='card_label'>
          <%= form.label :name, "Nome do Arquivo" %>
          <%= form.text_field :name %>
        </div>
        <div class='card_label'>
          <%= form.file_field :file %>
        </div>
        <div>
          <%= form.submit "Upload", class:"card_submit" %>
        </div>
      </div>
    <% end %>

  </div>
</div>