<div class="container">
  <div class="file_upload_edit">
    <h1> Editar Nome do Arquivo </h1>

    <%= form_with model: @archive, url: file_upload_path(@archive), method: :patch, local: true, multipart: true do |form| %>
      <div class="card">
        <div class="card_label">
          <%= form.label :name, "Nome do Arquivo" %>
          <%= form.text_field :name %>
        </div>
        <div class="card_buttons">
          <%= form.submit 'Atualizar', class: "button" %>
          <%= link_to 'Voltar', :back, class:"button" %>
        </div>
      </div>
    <% end %>

  </div>
</div>